# Runtime mode for key resolution: "dev" uses a locally generated RSA keypair
# and serves it at /.well-known/jwks.json. "production" fetches signing keys
# from JWKS_URL via PyJWKClient and NEVER generates or serves local keys.
JWKS_MODE=dev

# Directory where the dev keypair is generated/loaded (dev mode only)
DEV_KEYS_DIR=.devkeys

# Required in production mode: your identity provider's JWKS endpoint
JWKS_URL=

# JWKS client caching (production mode)
JWKS_CACHE_TTL_SECONDS=300
JWKS_LRU_MAX_KEYS=16
JWKS_TIMEOUT_SECONDS=5

# Token validation
JWT_ISSUER=https://auth.example.local
JWT_AUDIENCE=authorization-gateway
JWT_ALGORITHMS=RS256

# Correlation
CORRELATION_ID_HEADER=X-Correlation-ID

# Logging
LOG_LEVEL=INFO
